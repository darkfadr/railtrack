CONFIG=railtracks.json

# Optional: set if Railway CLI should authenticate non-interactively.
RAILWAY_TOKEN=

# Docker: required for container / docker-run — comma-separated Railway service IDs.
# The image entrypoint generates railtracks.json from these (no host railtracks file needed).
RAILWAY_SERVICES=

# Optional Railway environment name (default production in the image).
# RAILWAY_ENVIRONMENT=production

# Optional: passed through to Vector when launched from this shell.
VECTOR_LOG=info
