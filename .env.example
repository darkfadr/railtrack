CONFIG=railtracks.json

# Optional: set if Railway CLI should authenticate non-interactively.
RAILWAY_TOKEN=

# Docker entrypoint: comma-separated Railway service IDs (builds railtracks.json).
# RAILWAY_SERVICES=api,worker

# Optional Railway environment name for Docker / CLI (default production).
# RAILWAY_ENVIRONMENT=production

# Optional: passed through to Vector when launched from this shell.
VECTOR_LOG=info
